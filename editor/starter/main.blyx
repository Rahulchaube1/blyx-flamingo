use vendor::flamingo::flamingo;

fn main() {
    let samples = [3, 11];
    let include_zero = 1.0;
    let intervals = 4.0;
    let result = flamingo_axis(samples, include_zero, intervals);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
