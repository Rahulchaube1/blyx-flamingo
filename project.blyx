use std::cli;
use console;
use flamingo;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Produce chart-ready axis limits and labeled tick spacing from raw data.");
        println!("Usage: flamingo samples include_zero intervals");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = flamingo_axis([3, 11], 1.0, 4.0);
    } else {
        if count != 3 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let samples = console_vector(args_at(argv, 0));
        let include_zero = console_value(args_at(argv, 1));
        let intervals = console_value(args_at(argv, 2));
        result = flamingo_axis(samples, include_zero, intervals);
    }
    if len(result) == 0 { stderr_line("Invalid input for Flamingo. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
